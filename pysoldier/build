#!/bin/bash

set -e

rm -f  /tmp/*.o /tmp/xsoldier
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2  -c -o /tmp/callback.o callback.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/common.o common.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/enemy.o enemy.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/enemyshot.o enemyshot.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/game.o game.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/graphic.o graphic.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/image.o image.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/input.o input.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/main.o main.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/manage.o manage.c
gcc -DHAVE_CONFIG_H -I.  -DDATADIR=\"/usr/local/share\" -DLOCALSTATEDIR=\"/usr/local/var\"    -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2 -c -o /tmp/player.o player.c
gcc   -Wall -Wshadow -Wpointer-arith -Wcast-align -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wnested-externs -Winline -pedantic -Wno-long-long -g -O2   -o /tmp/xsoldier /tmp/*.o  -lSM -lICE -lX11 -lXpm  
/tmp/xsoldier | ./pysoldier
